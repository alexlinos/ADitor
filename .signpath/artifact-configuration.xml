<?xml version="1.0" encoding="utf-8"?>
<!-- Paste into SignPath: Project > Artifact configurations. The GitHub
     artifact "aditor-windows" is a zip holding the two executables. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ADitor.exe" product-name="ADitor">
      <authenticode-sign />
    </pe-file>
    <pe-file path="aditor-cli.exe" product-name="ADitor">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
