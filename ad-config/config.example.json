{
    "active_directory": {
        "server": "ldaps://dc.example.com:636",
        "server_pool": [
            "ldaps://dc2.example.com:636"
        ],
        "domain": "example.com",
        "base_dn": "DC=example,DC=com",
        "bind_dn": "EXAMPLE\\svc-aditor",
        "password": "${AD_MCP_PASSWORD}",
        "timeout": 30,
        "receive_timeout": 10
    },
    "security": {
        "validate_certificate": true,
        "ca_cert_file": "/path/to/ca-certificate.pem"
    },
    "performance": {
        "max_retries": 3,
        "retry_delay": 1.0,
        "page_size": 1000
    }
}
